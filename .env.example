# Copy to .env, fill in, then load it: set -a; . ./.env; set +a
# Never commit .env.

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Django. In production: a long random DJANGO_SECRET_KEY, DJANGO_DEBUG=0, your real host.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_PATH=./db.sqlite3
